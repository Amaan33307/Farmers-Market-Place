# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

PORT=5000

# MongoDB Atlas or local MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/farmer_marketplace

# Any long random text (used to sign login sessions)
SESSION_SECRET=change-this-to-a-long-random-string

# ---------- Optional: AI assistant ----------
# Enables "Write with AI" (farmers) and the AI Shopping
# Assistant (marketplace). Set ONE of these keys.
# The AI Price Insight and recommendations work without any key.

# Google Gemini (free tier) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# OR Anthropic Claude (paid) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5
