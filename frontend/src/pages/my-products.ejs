<%- include("../components/header") %>

<style>

.products-page {
    background: #f5f7f4;
    min-height: calc(100vh - 80px);
    padding: 55px 0;
}

.product-card {
    border: none;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 7px 25px rgba(0,0,0,0.06);
    height: 100%;
}

.product-image {
    height: 210px;
    width: 100%;
    object-fit: cover;
    background: #e8eee9;
}

.no-image {
    height: 210px;
    background: #e8eee9;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 55px;
}

.price {
    color: #28703d;
    font-size: 21px;
    font-weight: 700;
}

</style>


<section class="products-page">

    <div class="container">

        <div class="d-flex justify-content-between align-items-center mb-5 flex-wrap gap-3">

            <div>

                <span class="text-success fw-semibold">
                    FARMER DASHBOARD
                </span>

                <h1 class="fw-bold mt-2 mb-1">
                    My Products
                </h1>

                <p class="text-muted mb-0">
                    Manage products you have listed.
                </p>

            </div>

            <a
                href="/products/add"
                class="btn btn-success px-4"
            >
                <i class="bi bi-plus-circle me-2"></i>
                Add Product
            </a>

        </div>


        <% if (!products || products.length === 0) { %>

            <div class="card border-0 shadow-sm text-center p-5">

                <div style="font-size:60px;">
                    🌾
                </div>

                <h3 class="fw-bold mt-3">
                    No Products Yet
                </h3>

                <p class="text-muted">
                    Start selling by adding your first agricultural product.
                </p>

                <div>

                    <a
                        href="/products/add"
                        class="btn btn-success"
                    >
                        Add Your First Product
                    </a>

                </div>

            </div>

        <% } else { %>


            <div class="row g-4">

                <% products.forEach(product => { %>

                    <div class="col-lg-4 col-md-6">

                        <div class="card product-card">

                            <% if (product.image) { %>

                                <img
                                    src="<%= product.image %>"
                                    class="product-image"
                                    alt="<%= product.name %>"
                                >

                            <% } else { %>

                                <div class="no-image">
                                    🌾
                                </div>

                            <% } %>


                            <div class="card-body p-4">

                                <div class="d-flex flex-wrap gap-1 mb-2">

                                    <span class="badge bg-success-subtle text-success">
                                        <%= product.category %>
                                    </span>

                                    <% if (product.quantity < 1) { %>

                                        <span class="badge text-bg-secondary">Out of stock</span>

                                    <% } else if (product.quantity <= 5) { %>

                                        <span class="badge text-bg-warning">Low stock</span>

                                    <% } %>

                                    <% if (pendingCounts[String(product._id)]) { %>

                                        <a href="/orders/farmer-requests?status=pending" class="badge text-bg-info text-decoration-none">
                                            <%= pendingCounts[String(product._id)] %> pending request<%= pendingCounts[String(product._id)] === 1 ? "" : "s" %>
                                        </a>

                                    <% } %>

                                </div>

                                <h5 class="fw-bold">
                                    <%= product.name %>
                                </h5>

                                <p class="text-muted small">
                                    <%= (product.description || "").length > 100
                                        ? product.description.substring(0, 100) + "..."
                                        : product.description
                                    %>
                                </p>

                                <div class="price mb-2">
                                    ₹<%= product.price %>
                                    <span class="text-muted fs-6">
                                        / <%= product.unit %>
                                    </span>
                                </div>

                                <div class="text-muted small mb-3">

                                    <i class="bi bi-box-seam me-1"></i>

                                    <%= product.quantity %>
                                    <%= product.unit %>

                                    <span class="mx-2">•</span>

                                    <i class="bi bi-geo-alt me-1"></i>

                                    <%= product.location %>

                                </div>


                                <div class="d-flex gap-2">

                                    <a
                                        href="/products/<%= product._id %>"
                                        class="btn btn-outline-success flex-grow-1"
                                    >
                                        View
                                    </a>

                                    <a
                                        href="/products/<%= product._id %>/edit"
                                        class="btn btn-success"
                                        title="Edit product"
                                    >
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <form
                                        action="/products/<%= product._id %>/delete"
                                        method="POST"
                                        onsubmit="return confirm('Delete this product? Pending requests for it will be closed.')"
                                    >

                                        <button
                                            type="submit"
                                            class="btn btn-outline-danger"
                                            title="Delete product"
                                        >
                                            <i class="bi bi-trash"></i>
                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } %>

    </div>

</section>


<%- include("../components/footer") %>