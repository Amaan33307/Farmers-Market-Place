<%- include("../components/header") %>

<style>

.error-page {
    background: #f5f7f4;
    min-height: calc(100vh - 80px);
    padding: 80px 0;
}

.error-card {
    max-width: 560px;
    margin: auto;
    border: none;
    border-radius: 18px;
    box-shadow: 0 10px 35px rgba(0,0,0,0.07);
}

.error-code {
    font-size: 72px;
    font-weight: 700;
    color: #28703d;
    line-height: 1;
}

</style>


<section class="error-page">

    <div class="container">

        <div class="card error-card text-center">

            <div class="card-body p-5">

                <div class="error-code mb-2">
                    <%= status %>
                </div>

                <div style="font-size:50px;">
                    <% if (status === 403) { %>
                        🔒
                    <% } else if (status === 404) { %>
                        🌾
                    <% } else { %>
                        ⚠️
                    <% } %>
                </div>

                <h2 class="fw-bold mt-3">
                    <%= title %>
                </h2>

                <p class="text-muted mb-4">
                    <%= message %>
                </p>


                <div class="d-flex gap-2 justify-content-center flex-wrap">

                    <a href="/" class="btn btn-outline-success px-4">
                        <i class="bi bi-house me-1"></i>
                        Home
                    </a>

                    <a href="/marketplace" class="btn btn-success px-4">
                        <i class="bi bi-shop me-1"></i>
                        Marketplace
                    </a>

                    <% if (userId) { %>

                        <a href="/dashboard" class="btn btn-outline-success px-4">
                            <i class="bi bi-speedometer2 me-1"></i>
                            Dashboard
                        </a>

                    <% } else { %>

                        <a href="/login" class="btn btn-outline-success px-4">
                            <i class="bi bi-box-arrow-in-right me-1"></i>
                            Login
                        </a>

                    <% } %>

                </div>

            </div>

        </div>

    </div>

</section>


<%- include("../components/footer") %>
