<%- include("../components/header") %>

<style>

.requests-page {
    background: #f5f7f4;
    min-height: calc(100vh - 80px);
    padding: 55px 0;
}

.request-card {
    border: none;
    border-radius: 15px;
    box-shadow: 0 7px 25px rgba(0,0,0,0.06);
}

</style>


<section class="requests-page">

    <div class="container">

        <div class="mb-5">

            <span class="text-success fw-semibold">
                FARMER DASHBOARD
            </span>

            <h1 class="fw-bold mt-2 mb-1">
                Product Requests
            </h1>

            <p class="text-muted">
                Review and manage requests from buyers.
            </p>

        </div>


        <!-- STATUS FILTER -->

        <div class="d-flex flex-wrap gap-2 mb-4">

            <% [
                { value: "", label: "All" },
                { value: "pending", label: "Pending" },
                { value: "accepted", label: "Accepted" },
                { value: "rejected", label: "Rejected" },
                { value: "completed", label: "Completed" }
            ].forEach(item => { %>

                <a
                    href="/orders/farmer-requests<%= item.value ? '?status=' + item.value : '' %>"
                    class="btn btn-sm <%= statusFilter === item.value ? 'btn-success' : 'btn-outline-success' %>"
                >
                    <%= item.label %>
                </a>

            <% }) %>

        </div>


        <% if (!orders || orders.length === 0) { %>

            <div class="card border-0 shadow-sm text-center p-5">

                <div style="font-size:60px;">
                    📦
                </div>

                <h3 class="fw-bold mt-3">
                    No Requests Yet
                </h3>

                <p class="text-muted">
                    <%= statusFilter ? "No " + statusFilter + " requests." : "Buyer requests for your products will appear here." %>
                </p>

            </div>

        <% } else { %>


            <div class="row g-4">

                <% orders.forEach(order => { %>

                    <div class="col-lg-6">

                        <div class="card request-card">

                            <div class="card-body p-4">


                                <div class="d-flex justify-content-between align-items-start">

                                    <div>

                                        <span class="badge bg-success-subtle text-success">
                                            Product Request
                                        </span>

                                        <h4 class="fw-bold mt-3">
                                            <%= order.productName %>
                                        </h4>

                                    </div>


                                    <% if (order.status === "pending") { %>

                                        <span class="badge text-bg-warning">
                                            Pending
                                        </span>

                                    <% } else if (order.status === "accepted") { %>

                                        <span class="badge text-bg-success">
                                            Accepted
                                        </span>

                                    <% } else if (order.status === "rejected") { %>

                                        <span class="badge text-bg-danger">
                                            Rejected
                                        </span>

                                    <% } else { %>

                                        <span class="badge text-bg-primary">
                                            Completed (Paid)
                                        </span>

                                    <% } %>

                                </div>


                                <hr>


                                <div class="row g-3">

                                    <div class="col-6">

                                        <small class="text-muted">
                                            Buyer
                                        </small>

                                        <div class="fw-semibold">
                                            <%= order.buyerName %>
                                        </div>

                                        <% if (order.buyer && order.buyer.phone && order.status !== "rejected") { %>

                                            <a href="tel:<%= order.buyer.phone %>" class="small text-success text-decoration-none">
                                                <i class="bi bi-telephone"></i>
                                                <%= order.buyer.phone %>
                                            </a>

                                        <% } %>

                                    </div>


                                    <div class="col-6">

                                        <small class="text-muted">
                                            Quantity
                                        </small>

                                        <div class="fw-semibold">
                                            <%= order.quantity %>
                                            <%= order.unit %>
                                        </div>

                                    </div>


                                    <div class="col-6">

                                        <small class="text-muted">
                                            Price
                                        </small>

                                        <div class="fw-semibold text-success">
                                            ₹<%= order.price %> / <%= order.unit %>
                                        </div>

                                    </div>


                                    <div class="col-6">

                                        <small class="text-muted">
                                            Total Value
                                        </small>

                                        <div class="fw-bold">
                                            ₹<%= order.totalAmount %>
                                        </div>

                                    </div>

                                </div>


                                <% if (order.message) { %>

                                    <div class="bg-light rounded p-3 mt-3">

                                        <small class="text-muted">
                                            Buyer Message
                                        </small>

                                        <div>
                                            <%= order.message %>
                                        </div>

                                    </div>

                                <% } %>


                                <% if (order.status === "pending") { %>

                                    <% if (!order.product) { %>

                                        <div class="alert alert-secondary small mt-3 mb-0">
                                            This product was deleted.
                                        </div>

                                    <% } else if (order.product.quantity < order.quantity) { %>

                                        <div class="alert alert-warning small mt-3 mb-0">
                                            Only <%= order.product.quantity %> <%= order.unit %> left in stock —
                                            update your stock or reject this request.
                                        </div>

                                    <% } else { %>

                                        <div class="small text-muted mt-3">
                                            In stock: <%= order.product.quantity %> <%= order.unit %>
                                        </div>

                                    <% } %>

                                    <div class="d-flex gap-2 mt-3">

                                        <form
                                            action="/orders/<%= order._id %>/accept"
                                            method="POST"
                                            class="flex-grow-1"
                                        >

                                            <button
                                                type="submit"
                                                class="btn btn-success w-100"
                                            >
                                                <i class="bi bi-check-circle me-1"></i>
                                                Accept
                                            </button>

                                        </form>


                                        <form
                                            action="/orders/<%= order._id %>/reject"
                                            method="POST"
                                            class="flex-grow-1"
                                        >

                                            <button
                                                type="submit"
                                                class="btn btn-outline-danger w-100"
                                            >
                                                <i class="bi bi-x-circle me-1"></i>
                                                Reject
                                            </button>

                                        </form>

                                    </div>

                                <% } %>


                                <div class="small text-muted mt-3">

                                    Requested on

                                    <%= new Date(order.createdAt).toLocaleDateString("en-IN") %>

                                </div>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } %>

    </div>

</section>


<%- include("../components/footer") %>