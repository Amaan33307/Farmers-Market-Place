<%- include('../components/header') %>

<style>

    .notifications-page {
        min-height: calc(100vh - 80px);
        background: #f5f7f4;
        padding: 50px 0;
    }

    .notifications-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }

    .notifications-label {
        color: #28703d;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .notifications-title {
        font-weight: 700;
        margin-top: 5px;
        margin-bottom: 5px;
    }

    .notification-card {
        background: white;
        border: none;
        border-radius: 14px;
        padding: 20px;
        margin-bottom: 15px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        transition: 0.2s ease;
    }

    .notification-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.08);
    }

    .notification-card.unread {
        border-left: 5px solid #28703d;
    }

    .notification-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: #eaf5ed;
        color: #28703d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
        flex-shrink: 0;
    }

    .notification-title {
        font-weight: 700;
        margin-bottom: 5px;
    }

    .notification-message {
        color: #666;
        margin-bottom: 5px;
    }

    .notification-time {
        color: #999;
        font-size: 12px;
    }

    .unread-badge {
        background: #28703d;
        color: white;
        font-size: 11px;
        padding: 5px 9px;
        border-radius: 20px;
    }

    .empty-notifications {
        background: white;
        border-radius: 18px;
        padding: 80px 20px;
        text-align: center;
        box-shadow: 0 5px 25px rgba(0,0,0,0.05);
    }

    .empty-icon {
        font-size: 60px;
        margin-bottom: 20px;
    }

    @media (max-width: 576px) {

        .notifications-page {
            padding: 30px 15px;
        }

        .notifications-header {
            align-items: flex-start;
            flex-direction: column;
        }

    }

</style>


<section class="notifications-page">

    <div class="container">

        <!-- =========================
             HEADER
        ========================== -->

        <div class="notifications-header">

            <div>

                <div class="notifications-label">
                    NOTIFICATIONS
                </div>

                <h1 class="notifications-title">
                    Your Notifications
                </h1>

                <p class="text-muted mb-0">
                    Stay updated about your marketplace activity.
                </p>

            </div>


            <% if (unreadCount > 0) { %>

                <form
                    action="/notifications/mark-all-read"
                    method="POST"
                >

                    <button
                        type="submit"
                        class="btn btn-outline-success"
                    >

                        <i class="bi bi-check2-all"></i>

                        Mark All as Read

                    </button>

                </form>

            <% } %>

        </div>


        <!-- =========================
             NOTIFICATIONS
        ========================== -->

        <% if (notifications.length === 0) { %>

            <div class="empty-notifications">

                <div class="empty-icon">
                    🔔
                </div>

                <h3 class="fw-bold">
                    No Notifications
                </h3>

                <p class="text-muted">
                    You're all caught up.
                </p>

                <a
                    href="/dashboard"
                    class="btn btn-success px-4"
                >
                    Go to Dashboard
                </a>

            </div>


        <% } else { %>


            <% notifications.forEach(notification => { %>

                <div
                    class="notification-card
                    <%= notification.read ? '' : 'unread' %>"
                >

                    <div class="d-flex gap-3">

                        <!-- ICON -->

                        <div class="notification-icon">

                            <% if (notification.type === "request") { %>

                                <i class="bi bi-box-seam"></i>

                            <% } else if (notification.type === "accepted") { %>

                                <i class="bi bi-check-circle"></i>

                            <% } else if (notification.type === "rejected") { %>

                                <i class="bi bi-x-circle"></i>

                            <% } else { %>

                                <i class="bi bi-bell"></i>

                            <% } %>

                        </div>


                        <!-- CONTENT -->

                        <div class="flex-grow-1">

                            <div class="d-flex justify-content-between align-items-start gap-2">

                                <h5 class="notification-title">
                                    <%= notification.title %>
                                </h5>


                                <% if (!notification.read) { %>

                                    <span class="unread-badge">
                                        NEW
                                    </span>

                                <% } %>

                            </div>


                            <p class="notification-message">
                                <%= notification.message %>
                            </p>


                            <div class="notification-time">

                                <i class="bi bi-clock"></i>

                                <%= new Date(
                                    notification.createdAt
                                ).toLocaleString() %>

                            </div>


                            <div class="mt-3 d-flex gap-2 flex-wrap">

                                <% if (!notification.read) { %>

                                    <form
                                        action="/notifications/<%= notification._id %>/read"
                                        method="POST"
                                    >

                                        <button
                                            type="submit"
                                            class="btn btn-sm btn-outline-success"
                                        >

                                            <i class="bi bi-check2"></i>

                                            Mark as Read

                                        </button>

                                    </form>

                                <% } %>


                                <form
                                    action="/notifications/<%= notification._id %>/delete"
                                    method="POST"
                                >

                                    <button
                                        type="submit"
                                        class="btn btn-sm btn-outline-secondary"
                                    >

                                        <i class="bi bi-trash"></i>

                                        Delete

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>

            <% }) %>


        <% } %>

    </div>

</section>


<%- include('../components/footer') %>