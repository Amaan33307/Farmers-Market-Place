<%- include("../components/header") %>

<style>

.add-page {
    background: #f5f7f4;
    min-height: calc(100vh - 80px);
    padding: 60px 0;
}

.add-card {
    max-width: 850px;
    margin: auto;
    border: none;
    border-radius: 18px;
    box-shadow: 0 10px 35px rgba(0,0,0,0.07);
}

.form-control,
.form-select {
    min-height: 48px;
    border-radius: 8px;
}

.form-control:focus,
.form-select:focus {
    border-color: #28703d;
    box-shadow: 0 0 0 0.2rem rgba(40,112,61,0.12);
}

.add-button {
    background: #28703d;
    border: none;
    min-height: 50px;
    font-weight: 600;
}

.add-button:hover {
    background: #1e572f;
}

</style>


<section class="add-page">

    <div class="container">

        <div class="card add-card">

            <div class="card-body p-4 p-md-5">

                <div class="mb-4">

                    <span class="text-success fw-semibold">
                        FARMER DASHBOARD
                    </span>

                    <h1 class="fw-bold mt-2">
                        Add New Product
                    </h1>

                    <p class="text-muted">
                        List your agricultural product on the marketplace.
                    </p>

                </div>


                <form
                    action="/products/add"
                    method="POST"
                >

                    <div class="row g-4">


                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Product Name
                            </label>

                            <input
                                type="text"
                                name="name"
                                class="form-control"
                                placeholder="e.g. Fresh Tomatoes"
                                value="<%= old.name || '' %>"
                                maxlength="100"
                                required
                            >

                        </div>


                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Category
                            </label>

                            <select
                                name="category"
                                class="form-select"
                                required
                            >

                                <option value="">
                                    Select Category
                                </option>

                                <% categories.forEach(cat => { %>

                                    <option
                                        value="<%= cat %>"
                                        <%= old.category === cat ? "selected" : "" %>
                                    >
                                        <%= cat %>
                                    </option>

                                <% }) %>

                            </select>

                        </div>


                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Price
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    ₹
                                </span>

                                <input
                                    type="number"
                                    name="price"
                                    class="form-control"
                                    min="0.01"
                                    step="0.01"
                                    placeholder="Price per unit"
                                    value="<%= old.price || '' %>"
                                    required
                                >

                            </div>

                        </div>


                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Quantity
                            </label>

                            <input
                                type="number"
                                name="quantity"
                                class="form-control"
                                min="0"
                                step="1"
                                placeholder="Available quantity"
                                value="<%= old.quantity || '' %>"
                                required
                            >

                        </div>


                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Unit
                            </label>

                            <select
                                name="unit"
                                class="form-select"
                                required
                            >

                                <option value="">
                                    Select Unit
                                </option>

                                <% units.forEach(unit => { %>

                                    <option
                                        value="<%= unit %>"
                                        <%= old.unit === unit ? "selected" : "" %>
                                    >
                                        <%= unit %>
                                    </option>

                                <% }) %>

                            </select>

                        </div>


                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Location
                            </label>

                            <input
                                type="text"
                                name="location"
                                class="form-control"
                                placeholder="e.g. Mumbai"
                                value="<%= old.location || '' %>"
                                required
                            >

                        </div>


                        <!-- AI PRICE INSIGHT -->

                        <div class="col-12">

                            <div class="d-flex align-items-center gap-2 flex-wrap">

                                <button
                                    type="button"
                                    id="aiPriceBtn"
                                    class="btn btn-outline-success btn-sm"
                                    data-exclude=""
                                >
                                    <i class="bi bi-stars me-1"></i>
                                    Get AI Price Insight
                                </button>

                                <span class="small text-muted">
                                    Compares your product with similar listings in the marketplace.
                                </span>

                            </div>

                            <div id="aiPriceResult" class="mt-2"></div>

                        </div>


                        <div class="col-12">

                            <label class="form-label fw-semibold">
                                Product Image URL
                            </label>

                            <input
                                type="url"
                                name="image"
                                class="form-control"
                                placeholder="https://example.com/image.jpg"
                                value="<%= old.image || '' %>"
                            >

                            <small class="text-muted">
                                Optional
                            </small>

                        </div>


                        <div class="col-12">

                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">

                                <label class="form-label fw-semibold mb-0">
                                    Description
                                </label>

                                <% if (aiEnabled) { %>

                                    <button
                                        type="button"
                                        id="aiDescBtn"
                                        class="btn btn-outline-success btn-sm"
                                        title="Type a few notes (optional), then let AI write the description"
                                    >
                                        <i class="bi bi-magic me-1"></i>
                                        Write with AI
                                    </button>

                                <% } %>

                            </div>

                            <textarea
                                name="description"
                                class="form-control"
                                rows="5"
                                placeholder="Describe your product..."
                                maxlength="1000"
                                required
                            ><%= old.description || '' %></textarea>

                            <div id="aiDescStatus" class="small text-muted"></div>


                        </div>


                    </div>


                    <div class="d-flex gap-3 mt-5">

                        <a
                            href="/dashboard"
                            class="btn btn-outline-secondary px-4"
                        >
                            Cancel
                        </a>

                        <button
                            type="submit"
                            class="btn btn-success add-button flex-grow-1"
                        >
                            <i class="bi bi-plus-circle me-2"></i>
                            Add Product
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</section>


<%- include("../components/footer") %>